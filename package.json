{
  "name": "insomnium",
  "private": true,
  "version": "1.0.0",
  "author": "Archy <archy@archgpt.dev>",
  "description": "Insomnium is a cross-platform REST client, built on top of Electron.",
  "license": "MIT",
  "repository": "https://github.com/ArchGPT/insomnium",
  "bugs": {
    "url": "https://github.com/ArchGPT/insomniumissues"
  },
  "homepage": "https://github.com/ArchGPT/insomnium#readme",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/insomnia-testing",
    "packages/insomnia-send-request",
    "packages/insomnia",
    "packages/insomnia-smoke-test"
  ],
  "scripts": {
    "dev": "bun run --filter './packages/insomnia' start",
    "lint": "bun run --workspaces --if-present lint",
    "type-check": "bun run --workspaces --if-present type-check",
    "test": "bun run --workspaces --if-present test",
    "version:workspaces": "bun ./scripts/version-workspaces.mjs",
    "lint:markdown": "bun x markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "clean": "git clean -dfX",
    "inso-start": "bun run start --workspace=packages/insomnia-inso",
    "inso-package": "bun run build:sr --workspace=packages/insomnia && bun run package --workspace=packages/insomnia-inso",
    "inso-package:artifacts": "bun run artifacts --workspace=packages/insomnia-inso",
    "test:bundled-inso": "bun run build --workspace=packages/insomnia-inso && bun run test:bundled-inso --workspace=packages/insomnia-inso",
    "watch:app": "bun run --filter './packages/insomnia' build:main.min.js && bun run --filter './packages/insomnia' start:dev-server",
    "app-build": "bun run --filter './packages/insomnia' build",
    "app-package": "bun run --filter './packages/insomnia' package",
    "test:smoke:dev": "bun run --filter './packages/insomnia-smoke-test' test:dev -- --project=Smoke",
    "test:smoke:build": "bun run --filter './packages/insomnia-smoke-test' test:build -- --project=Smoke",
    "test:smoke:package": "bun run --filter './packages/insomnia-smoke-test' test:package -- --project=Smoke",
    "test:smoke:cli": "bun run --filter './packages/insomnia-smoke-test' test:cli",
    "changelog-image": "bun ./scripts/changelog-image/changelog-image.ts",
    "download-all-npm-plugins": "bun ./scripts/download-all-npm-plugins.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@jest/globals": "^30.4.1",
    "@jest/types": "^30.4.1",
    "@types/chai": "^5.2.3",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/svgo": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "esbuild-runner": "^2.2.2",
    "eslint": "9.39.2",
    "eslint-config-helpers": "^1.2.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.4.2",
    "semver": "^7.8.5",
    "svg-text-to-path": "^2.1.0",
    "svgo": "^4.0.2",
    "ts-jest": "^29.4.12",
    "tslib": "2.8.1",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "protobufjs": "7.2.4"
  }
}
