  "license": "MIT",
  "author": "Archy <archy@archgpt.dev>",
  "main": "src/main.min.js",
  "scripts": {
    "build": "bun run build:sr && bun run build:app",
    "build:app": "bun ./scripts/build.ts --noErrorTruncation",
    "build:main.min.js": "cross-env NODE_ENV=development bun esbuild.main.ts",
    "build:sr": "bun esbuild.sr.ts && bun x --bun tsc --build tsconfig.build.sr.json",
    "lint": "bun x --bun eslint . --ext .js,.ts,.tsx --cache --fix",
    "package": "bun run build:app && cross-env USE_HARD_LINKS=false electron-builder build --config electron-builder.config.js",
    "start": "concurrently -n dev,app --kill-others \"bun run start:dev-server\" \"bun run start:electron\"",
    "start:dev-server": "bun x --bun vite dev",
    "start:electron": "bun run build:main.min.js && electron .",
    "test": "bun x jest",
    "electron:dev-build": "electron ./build/main.min.js",
    "test:watch": "bun x jest --watch",
    "type-check": "bun x --bun tsc --noEmit --project tsconfig.build.json",
    "type-check:watch": "bun run type-check -- --watch",
    "convert-svg": "bunx @svgr/cli@6.4.0 --no-index --config-file svgr.config.js --out-dir src/ui/components/assets/svgr src/ui/components/assets/"
  },
